{
  "__inputs": [],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" }
  ],
  "id": null,
  "uid": "llm-stack-llmops-rag",
  "title": "LLMOps, RAG & Privacy Guardrails",
  "description": "Observability for Chat UI, Trace Ingestion (Langfuse), and Web Search RAG (SearXNG).",
  "tags": ["llm-stack", "llmops", "rag", "searxng", "open-webui", "langfuse"],
  "timezone": "browser",
  "refresh": "15s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Chat UI & Trace Ingestion Overview",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Open WebUI Active Ingress",
      "type": "stat",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "sparkline"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(rate(traefik_service_requests_total{service=~\"open-webui.*\"}[1m])) or vector(0)", "legendFormat": "Chat req/s", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Langfuse Trace Ingestion",
      "type": "stat",
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "sparkline"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "purple", "value": null }]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(rate(traefik_service_requests_total{service=~\"langfuse.*\"}[1m])) or vector(0)", "legendFormat": "Trace req/s", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "SearXNG RAG Search Rate",
      "type": "stat",
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "sparkline"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(rate(traefik_service_requests_total{service=~\"searxng.*\"}[1m])) or vector(0)", "legendFormat": "Search req/s", "refId": "A" }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Throughput & Traffic Rates Over Time",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 11,
      "title": "Web UI & RAG Search Ingress Traffic",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(rate(traefik_service_requests_total{service=~\"open-webui.*\"}[1m]))", "legendFormat": "Open WebUI", "refId": "A" },
        { "expr": "sum(rate(traefik_service_requests_total{service=~\"searxng.*\"}[1m]))", "legendFormat": "SearXNG (RAG Search)", "refId": "B" },
        { "expr": "sum(rate(traefik_service_requests_total{service=~\"langfuse.*\"}[1m]))", "legendFormat": "Langfuse (Traces)", "refId": "C" }
      ]
    },
    {
      "id": 12,
      "title": "Container Resource Consumption (RAM)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "container_memory_usage_bytes{container_label_com_docker_compose_service=\"open-webui\"}", "legendFormat": "Open WebUI", "refId": "A" },
        { "expr": "container_memory_usage_bytes{container_label_com_docker_compose_service=\"langfuse-web\"}", "legendFormat": "Langfuse Web", "refId": "B" },
        { "expr": "container_memory_usage_bytes{container_label_com_docker_compose_service=\"langfuse-worker\"}", "legendFormat": "Langfuse Worker", "refId": "C" },
        { "expr": "container_memory_usage_bytes{container_label_com_docker_compose_service=\"searxng\"}", "legendFormat": "SearXNG", "refId": "D" }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "LLMOps, Guardrails & Search Logs",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 21,
      "title": "Live Logs (Open WebUI, SearXNG, Langfuse)",
      "type": "logs",
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 8 },
      "options": {
        "dedupStrategy": "none",
        "showLabels": false,
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "{container=~\".*open-webui.*|.*searxng.*|.*langfuse.*\"}", "refId": "A" }
      ]
    }
  ]
}

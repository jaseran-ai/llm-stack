{
  "__inputs": [],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" }
  ],
  "id": null,
  "uid": "llm-stack-llm-gateway",
  "title": "LLM Gateway (LiteLLM)",
  "description": "LiteLLM proxy metrics: request throughput, token usage, latency, model distribution, error rates, and budget tracking.",
  "tags": ["llm-stack", "litellm", "llm"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Request Traffic",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Total Requests (rate)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "sparkline"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "rate(litellm_proxy_total_requests_metric_total[2m])", "legendFormat": "req/s", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Failed Requests (rate)",
      "type": "stat",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "sparkline"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "rate(litellm_proxy_failed_requests_metric_total[2m])", "legendFormat": "err/s", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "In-Flight Requests",
      "type": "stat",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "sparkline"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "litellm_in_flight_requests", "legendFormat": "in-flight", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Active Users",
      "type": "stat",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "sparkline"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "litellm_active_users", "legendFormat": "users", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "title": "Error Rate %",
      "type": "stat",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "sparkline"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(litellm_proxy_failed_requests_metric_total[5m]) / rate(litellm_proxy_total_requests_metric_total[5m])",
          "legendFormat": "Error %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "P95 End-to-End Latency",
      "type": "stat",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "sparkline"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(litellm_request_total_latency_metric_bucket[5m]))",
          "legendFormat": "P95 latency",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Request Rate by Model",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(litellm_requests_metric_total[2m])",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Latency Percentiles (P50 / P95 / P99)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(litellm_request_total_latency_metric_bucket[5m]))", "legendFormat": "P50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(litellm_request_total_latency_metric_bucket[5m]))", "legendFormat": "P95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, rate(litellm_request_total_latency_metric_bucket[5m]))", "legendFormat": "P99", "refId": "C" }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Token Metrics",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 21,
      "title": "Input Tokens / s",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 8, "h": 7 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "rate(litellm_input_tokens_metric_total[2m])", "legendFormat": "Input tok/s", "refId": "A" }
      ]
    },
    {
      "id": 22,
      "title": "Output Tokens / s",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 14, "w": 8, "h": 7 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "rate(litellm_output_tokens_metric_total[2m])", "legendFormat": "Output tok/s", "refId": "A" }
      ]
    },
    {
      "id": 23,
      "title": "Cache Hit Rate",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 14, "w": 8, "h": 7 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(litellm_input_cached_tokens_metric_total[5m]) / (rate(litellm_input_tokens_metric_total[5m]) + rate(litellm_input_cached_tokens_metric_total[5m]))",
          "legendFormat": "Cache Hit %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "LLM API Backend",
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 31,
      "title": "Backend Latency per Output Token (P95)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 7 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(litellm_deployment_latency_per_output_token_bucket[5m]))",
          "legendFormat": "{{litellm_model_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 32,
      "title": "Time to First Token (P95)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 7 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(litellm_llm_api_time_to_first_token_metric_bucket[5m]))",
          "legendFormat": "TTFT P95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 33,
      "title": "Deployment State",
      "type": "table",
      "gridPos": { "x": 0, "y": 29, "w": 12, "h": 6 },
      "options": { "footer": { "show": false } },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "1": { "text": "healthy", "color": "green" } } },
                  { "type": "value", "options": { "2": { "text": "cooldown", "color": "yellow" } } },
                  { "type": "value", "options": { "3": { "text": "unavailable", "color": "red" } } }
                ]
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "litellm_deployment_state",
          "instant": true,
          "legendFormat": "{{litellm_model_name}}",
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["litellm_model_name", "api_base", "Value"] } } }
      ]
    },
    {
      "id": 34,
      "title": "API Key Budget Remaining",
      "type": "bargauge",
      "gridPos": { "x": 12, "y": 29, "w": 12, "h": 6 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "green", "value": 20 }
            ]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "litellm_remaining_api_key_budget_metric",
          "legendFormat": "{{hashed_api_key}}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 42,
      "type": "row",
      "title": "Backend Inference Engine (llama-server / remote GPU)",
      "gridPos": { "x": 0, "y": 35, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 43,
      "title": "Active Inferences",
      "type": "stat",
      "gridPos": { "x": 0, "y": 36, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 4 }
            ]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "llamacpp:requests_processing", "legendFormat": "Inferences", "refId": "A" }
      ]
    },
    {
      "id": 44,
      "title": "Deferred / Queue",
      "type": "stat",
      "gridPos": { "x": 4, "y": 36, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "llamacpp:requests_deferred", "legendFormat": "Queued", "refId": "A" }
      ]
    },
    {
      "id": 45,
      "title": "Generation Speed",
      "type": "stat",
      "gridPos": { "x": 8, "y": 36, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "sparkline"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "tokens/s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 5 }
            ]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "rate(llamacpp:tokens_predicted_total[1m]) / clamp_min(rate(llamacpp:tokens_predicted_seconds_total[1m]), 0.001)", "legendFormat": "tok/s", "refId": "A" }
      ]
    },
    {
      "id": 46,
      "title": "Prefill Speed",
      "type": "stat",
      "gridPos": { "x": 12, "y": 36, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "sparkline"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "tokens/s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "purple", "value": null },
              { "color": "green", "value": 50 }
            ]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "rate(llamacpp:prompt_tokens_total[1m]) / clamp_min(rate(llamacpp:prompt_seconds_total[1m]), 0.001)", "legendFormat": "tok/s", "refId": "A" }
      ]
    },
    {
      "id": 47,
      "title": "KV Cache Reuse",
      "type": "stat",
      "gridPos": { "x": 16, "y": 36, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 50 }
            ]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "100 * (rate(llamacpp:prompt_tokens_cached_total[5m]) / clamp_min(rate(llamacpp:prompt_tokens_total[5m]) + rate(llamacpp:prompt_tokens_cached_total[5m]), 0.001))", "legendFormat": "Cache hit %", "refId": "A" }
      ]
    },
    {
      "id": 48,
      "title": "Busy Decode Slots",
      "type": "stat",
      "gridPos": { "x": 20, "y": 36, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 4 }
            ]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "llamacpp:n_busy_slots_per_decode", "legendFormat": "Slots", "refId": "A" }
      ]
    },
    {
      "id": 49,
      "title": "Token Generation & Prefill Throughput",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 40, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "tokens/s",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "rate(llamacpp:prompt_tokens_total[1m])", "legendFormat": "Prompt tokens (prefill)", "refId": "A" },
        { "expr": "rate(llamacpp:tokens_predicted_total[1m])", "legendFormat": "Generated tokens", "refId": "B" },
        { "expr": "rate(llamacpp:prompt_tokens_cached_total[1m])", "legendFormat": "Cached tokens", "refId": "C" }
      ]
    },
    {
      "id": 50,
      "title": "Slot Concurrency & Inferences In-Flight",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 40, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 15 }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "llamacpp:requests_processing", "legendFormat": "Processing requests", "refId": "A" },
        { "expr": "llamacpp:n_busy_slots_per_decode", "legendFormat": "Busy slots", "refId": "B" },
        { "expr": "llamacpp:requests_deferred", "legendFormat": "Deferred requests", "refId": "C" }
      ]
    },
    {
      "id": 40,
      "type": "row",
      "title": "LiteLLM Logs",
      "gridPos": { "x": 0, "y": 48, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 41,
      "title": "LiteLLM Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 49, "w": 24, "h": 8 },
      "options": {
        "dedupStrategy": "none",
        "showLabels": false,
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "{container=~\".*litellm.*\"}", "refId": "A" }
      ]
    }
  ]
}

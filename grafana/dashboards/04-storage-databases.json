{
  "__inputs": [],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" }
  ],
  "id": null,
  "uid": "llm-stack-storage",
  "title": "Storage & Databases",
  "description": "Qdrant vector store, Redis cache, ClickHouse analytics, and PostgreSQL (pgBouncer) — container-level and native metrics.",
  "tags": ["llm-stack", "storage", "qdrant", "redis", "clickhouse", "postgres"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Qdrant — Vector Store",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Total Collections",
      "type": "stat",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "sparkline"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "collections_total", "legendFormat": "collections", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Total Vectors",
      "type": "stat",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "sparkline"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(collections_vector_total)", "legendFormat": "vectors", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Points per Collection",
      "type": "bargauge",
      "gridPos": { "x": 8, "y": 1, "w": 16, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "collection_points",
          "legendFormat": "{{collection_name}}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Running Optimizations",
      "type": "stat",
      "gridPos": { "x": 0, "y": 5, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "sparkline"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(collection_running_optimizations)", "legendFormat": "optimizing", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "title": "Update Queue Length",
      "type": "stat",
      "gridPos": { "x": 4, "y": 5, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "sparkline"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(collection_update_queue_length)", "legendFormat": "queue", "refId": "A" }
      ]
    },
    {
      "id": 10,
      "title": "Qdrant CPU Usage by Collection",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 7 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(collection_hardware_metric_cpu[2m])",
          "legendFormat": "{{collection_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Qdrant Vector I/O",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 7 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(collection_hardware_metric_vector_io_read[2m])",
          "legendFormat": "read {{collection_name}}",
          "refId": "A"
        },
        {
          "expr": "rate(collection_hardware_metric_vector_io_write[2m])",
          "legendFormat": "write {{collection_name}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Container Resources (Redis / ClickHouse / Postgres / pgBouncer)",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 21,
      "title": "Container CPU Usage",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 17, "w": 12, "h": 7 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\".*redis.*|.*clickhouse.*|.*postgres.*|.*pgbouncer.*|.*qdrant.*\"}[2m])",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "title": "Container Memory Usage",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 17, "w": 12, "h": 7 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name=~\".*redis.*|.*clickhouse.*|.*postgres.*|.*pgbouncer.*|.*qdrant.*\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 23,
      "title": "Container Network I/O",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 7 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(container_network_receive_bytes_total{name=~\".*redis.*|.*clickhouse.*|.*postgres.*|.*pgbouncer.*|.*qdrant.*\"}[2m])",
          "legendFormat": "RX {{name}}",
          "refId": "A"
        },
        {
          "expr": "rate(container_network_transmit_bytes_total{name=~\".*redis.*|.*clickhouse.*|.*postgres.*|.*pgbouncer.*|.*qdrant.*\"}[2m])",
          "legendFormat": "TX {{name}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 24,
      "title": "Container Disk I/O",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 7 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(container_fs_reads_bytes_total{name=~\".*redis.*|.*clickhouse.*|.*postgres.*|.*pgbouncer.*|.*qdrant.*\"}[2m])",
          "legendFormat": "Read {{name}}",
          "refId": "A"
        },
        {
          "expr": "rate(container_fs_writes_bytes_total{name=~\".*redis.*|.*clickhouse.*|.*postgres.*|.*pgbouncer.*|.*qdrant.*\"}[2m])",
          "legendFormat": "Write {{name}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Logs",
      "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 31,
      "title": "Redis Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 7 },
      "options": {
        "dedupStrategy": "none",
        "showLabels": false,
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "{container=~\".*redis.*\"}", "refId": "A" }
      ]
    },
    {
      "id": 32,
      "title": "ClickHouse Logs",
      "type": "logs",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 7 },
      "options": {
        "dedupStrategy": "none",
        "showLabels": false,
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "{container=~\".*clickhouse.*\"}", "refId": "A" }
      ]
    },
    {
      "id": 33,
      "title": "Postgres / pgBouncer Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 39, "w": 12, "h": 7 },
      "options": {
        "dedupStrategy": "none",
        "showLabels": false,
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "{container=~\".*postgres.*|.*pgbouncer.*\"}", "refId": "A" }
      ]
    },
    {
      "id": 34,
      "title": "Qdrant Logs",
      "type": "logs",
      "gridPos": { "x": 12, "y": 39, "w": 12, "h": 7 },
      "options": {
        "dedupStrategy": "none",
        "showLabels": false,
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "{container=~\".*qdrant.*\"}", "refId": "A" }
      ]
    }
  ]
}

# Copy this file to uat/.env and set every value explicitly.
UAT_CANDIDATE_SHA=
UAT_DOCKER_CACHE_VOLUME=llm-stack-uat-docker-cache-local
UAT_OLLAMA_MODEL_VOLUME=llm-stack-uat-ollama-model-cache
UAT_DOMAIN=llm-stack.test
UAT_WORKTREE=/home/user/llm-stack/uat/runtime/worktree
UAT_DOCKER_PORT=12376
UAT_MIN_AVAILABLE_MEMORY_MIB=8192
UAT_MIN_AVAILABLE_DISK_MIB=30720

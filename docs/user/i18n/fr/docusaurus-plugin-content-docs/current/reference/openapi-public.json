{
  "openapi": "3.1.0",
  "info": {
    "title": "LLM Stack Public API",
    "version": "1.0.0",
    "description": "Public OpenAI-compatible inference and guardrail APIs for LLM Stack."
  },
  "servers": [
    {
      "url": "https://chat.{DOMAIN}/api",
      "description": "Production Ingress Gateway"
    }
  ],
  "paths": {
    "/v1/models": {
      "get": {
        "summary": "List Available Models",
        "operationId": "listModels",
        "x-llm-stack-audience": "public",
        "responses": {
          "200": {
            "description": "List of available LLM models and aliases",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "example": "list"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "example": "lfm2.5-thinking-1.2b"
                          },
                          "object": {
                            "type": "string",
                            "example": "model"
                          },
                          "owned_by": {
                            "type": "string",
                            "example": "llm-stack"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "summary": "Create Chat Completion",
        "operationId": "createChatCompletion",
        "x-llm-stack-audience": "public",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "messages"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "lfm2.5-thinking-1.2b"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "system",
                            "user",
                            "assistant"
                          ]
                        },
                        "content": {
                          "type": "string",
                          "example": "Hello, how can you help me?"
                        }
                      }
                    }
                  },
                  "temperature": {
                    "type": "number",
                    "default": 0.7
                  },
                  "stream": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat completion response with optional PII redaction applied",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "object": {
                      "type": "string",
                      "example": "chat.completion"
                    },
                    "created": {
                      "type": "integer"
                    },
                    "model": {
                      "type": "string"
                    },
                    "choices": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/embeddings": {
      "post": {
        "summary": "Generate Text Embeddings",
        "operationId": "createEmbedding",
        "x-llm-stack-audience": "public",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "text-embedding-nomic"
                  },
                  "input": {
                    "type": "string",
                    "example": "Semantic chunk for vector indexing"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated embedding vector",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "example": "list"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Public Liveness Probe",
        "operationId": "getHealth",
        "x-llm-stack-audience": "public",
        "responses": {
          "200": {
            "description": "Gateway is online and operational",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {}
}
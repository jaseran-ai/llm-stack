# ==============================================================================
# LLM Stack Environment Configuration (.env)
# ==============================================================================

# --- Ports ---
OLLAMA_WEBAPI_PORT=12434
OPEN_WEBUI_PORT=8080
LITELLM_PORT=4001

# --- Dynamic Host Domain & Email Domain ---
# DOMAIN is auto-detected by setup.sh (mDNS hostname via Avahi if active, otherwise the LAN IP)
# and should normally NOT be set manually here — it can be overridden via `DOMAIN=xxx ./setup.sh`
# or `./setup.sh --domain=xxx`. The value below is purely illustrative.
DOMAIN=dev.local
EMAIL_DOMAIN=example.com
SECRETS_RAM_UID=1000
SECRETS_RAM_GID=1000
SECRETS_RENDER_GID=1000
SECRETS_RAM_ID=validation-only

# --- TLS & Ingress Configuration ---
# Real, browser-trusted TLS certificates (optional - see caddy/README.md)
TLS_MODE=internal
CLOUDFLARE_API_TOKEN=
ACME_EMAIL=

# --- DNS & Resolution Mode (hosts | coredns | cloudflare) ---
# hosts      : Default. Zero-dependency manual /etc/hosts or external DNS.
# coredns    : Bundled CoreDNS server resolving ${DOMAIN} and *.${DOMAIN} to ${LAN_IP}.
# cloudflare : Cloudflare Zero Trust Tunnel (COMPOSE_PROFILES=cloudflare).
DNS_MODE=hosts
COREDNS_BIND_IP=127.0.0.1

# --- Cloudflare Tunnel (Optional) ---
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=

# --- Bootstrap & IdP Secrets ---
# Required in .env for database bootstrap and Authentik/Vault OIDC discovery setup
POSTGRES_PASSWORD=postgres_password_change_me
CLICKHOUSE_PASSWORD=clickhouse_password_change_me
AUTHENTIK_SECRET_KEY=generated_random_base64_secret
AUTHENTIK_BOOTSTRAP_TOKEN=generated_random_256bit_hex_secret
VAULT_OIDC_CLIENT_SECRET=generated_random_256bit_hex_secret
LANGFUSE_OIDC_CLIENT_SECRET=generated_random_256bit_hex_secret
LITELLM_OIDC_CLIENT_SECRET=generated_random_256bit_hex_secret
CHOUSE_UI_OIDC_CLIENT_SECRET=generated_random_256bit_hex_secret
UI_PASSWORD=CHANGE_ME_OR_GENERATED_BY_SETUP
ALICE_PASSWORD=CHANGE_ME_OR_GENERATED_BY_SETUP
BOB_PASSWORD=CHANGE_ME_OR_GENERATED_BY_SETUP

# Note: All 16 applicative secrets (Grafana Admin Password, Qdrant API Key, LiteLLM Master Key,
# WebUI Secret, Redis Auth, Langfuse Salt/Keys, CHouse UI Secrets, SearXNG Secret, etc.) are
# generated dynamically at setup time, stored encrypted inside HashiCorp Vault KV v2, and rendered
# in RAM by Vault Agent into /run/secrets/*.env. No applicative secrets are stored in .env!

# --- Operational Configuration ---
TELEMETRY_ENABLED=true
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=true
LANGFUSE_USE_AZURE_BLOB=false
LANGFUSE_INIT_ORG_ID=cmct8rhde0006lm078h7kb93c
LANGFUSE_INIT_ORG_NAME="LLMStack"
LANGFUSE_INIT_PROJECT_ID=cmct8ruwk000blm07y026jjpp
LANGFUSE_INIT_PROJECT_NAME="llm-stack-project"

CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_CLUSTER_ENABLED=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TLS_ENABLED=false
REDIS_TLS_CA=/certs/ca.crt
REDIS_TLS_CERT=/certs/redis.crt
REDIS_TLS_KEY=/certs/redis.key

# Langfuse S3 Storage Buckets (SeaweedFS backend)
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://seaweedfs:8333
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://seaweedfs:8333
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/
LANGFUSE_S3_BATCH_EXPORT_ENABLED=false
LANGFUSE_S3_BATCH_EXPORT_BUCKET=langfuse
LANGFUSE_S3_BATCH_EXPORT_PREFIX=exports/
LANGFUSE_S3_BATCH_EXPORT_REGION=auto
LANGFUSE_S3_BATCH_EXPORT_ENDPOINT=http://seaweedfs:8333
LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=https://s3.dev.local
LANGFUSE_S3_BATCH_EXPORT_FORCE_PATH_STYLE=true

# --- Automated Backup Encryption ---
# Generated by setup.sh; used for AES-256-CBC encryption with PBKDF2-HMAC-SHA256 (200k iterations)
BACKUP_PASSPHRASE=generated_random_256bit_hex_secret

global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - "/etc/prometheus/rules/*.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['alertmanager:9093']

scrape_configs:
  - job_name: 'litellm'
    metrics_path: '/metrics/'
    static_configs:
      - targets: ['litellm:4000']

  - job_name: 'qdrant'
    metrics_path: '/metrics'
    http_headers:
      api-key:
        secrets: ['${QDRANT_API_KEY}']
    static_configs:
      - targets: ['qdrant:6333']

  - job_name: 'cadvisor'
    metrics_path: '/metrics'
    static_configs:
      - targets: ['cadvisor:8080']

  - job_name: 'node-exporter'
    metrics_path: '/metrics'
    static_configs:
      - targets: ['node-exporter:9100']

  - job_name: 'traefik'
    metrics_path: '/metrics'
    static_configs:
      - targets: ['traefik:8082']

  - job_name: 'alertmanager'
    metrics_path: '/metrics'
    static_configs:
      - targets: ['alertmanager:9093']

  - job_name: 'authentik'
    metrics_path: '/metrics'
    static_configs:
      - targets: ['authentik-server:9300']

  - job_name: 'betterleaks'
    metrics_path: '/metrics'
    static_configs:
      - targets: ['betterleaks:8080']

  # Dynamic local targets discovered from /etc/prometheus/targets.d/ (gitignored)
  - job_name: 'custom_targets'
    file_sd_configs:
      - files:
          - '/etc/prometheus/targets.d/*.yml'
          - '/etc/prometheus/targets.d/*.json'
